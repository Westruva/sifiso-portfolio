// Cloudflare Workers config, read by `npx wrangler deploy` during Cloudflare's build.
{
  // Must match the existing Worker's name so deploys update it (and keep sifisowmoyo.com attached)
  "name": "sifiso-portfolio",
  "compatibility_date": "2026-10-03",
  "assets": {
    // Vite's build output
    "directory": "./dist",
    // Unknown URLs get 404.html with a real 404 status, instead of the homepage with 200
    "not_found_handling": "404-page"
  }
}
